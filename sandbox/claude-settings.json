{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ],
    "ask": [
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)"
    ],
    "defaultMode": "auto"
  },
  "sandbox": {
    "enabled": false
  },
  "theme": "auto"
}
