{
  "env": {
    "CLAUDE_CODE_PACKAGE_MANAGER_AUTO_UPDATE": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "mcp__context7"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(~/.ssh/**)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git rebase *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowLocalBinding": true
    }
  },
  "model": "opus",
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true
  },
  "theme": "auto"
}
