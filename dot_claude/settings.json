{
  "env": {
    "CLAUDE_CODE_PACKAGE_MANAGER_AUTO_UPDATE": "1"
  },
  "model": "sonnet",
  "theme": "auto",
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "ralph-loop@anthropic-plugin-directory": true
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": ["Edit", "Write", "WebFetch", "WebSearch"],
    "deny": [
      "Read(~/.ssh/**)", "Read(.env*)", "Read(!.env.example)",
      "Bash(sudo *)",
      "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git push origin main*)"
    ],
    "ask": [
      "Bash(rm -rf *)", "Bash(rm -fr *)",
      "Bash(git reset --hard*)", "Bash(git clean *)", "Bash(git rebase *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": true,
    "network": { "allowLocalBinding": true },
    "excludedCommands": ["git init *"]
  }
}
