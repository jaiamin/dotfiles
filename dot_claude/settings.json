{
  "env": {
    "CLAUDE_CODE_PACKAGE_MANAGER_AUTO_UPDATE": "1"
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "mcp__context7"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Bash(sudo *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git rebase *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "ralph-loop@anthropic-plugin-directory": true
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowLocalBinding": true
    },
    "excludedCommands": [
      "git init *"
    ]
  },
  "theme": "auto"
}
