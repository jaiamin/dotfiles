{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "autoupdate": false,
  "share": "disabled",
  "mcp": {
    "context7": { "type": "remote", "url": "https://mcp.context7.com/mcp" }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "ask",
    "doom_loop": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny", "*.env.*": "deny", "*.env.example": "allow",
      "~/.ssh/**": "deny"
    },
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "git push --force*": "deny", "git push -f*": "deny", "git push origin main*": "deny",
      "rm -rf*": "ask", "rm -fr*": "ask",
      "git reset --hard*": "ask", "git clean*": "ask", "git rebase*": "ask"
    }
  }
}
