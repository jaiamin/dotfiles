{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "autoupdate": false,
  "share": "disabled",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"]
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "rm -rf*": "deny", "sudo *": "deny",
      "git push --force*": "deny", "git push -f*": "deny", "git push origin main*": "deny",
      "git reset --hard*": "deny", "git rebase*": "deny",
      "curl * | sh*": "deny", "curl * | bash*": "deny"
    }
  }
}
