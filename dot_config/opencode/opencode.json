{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "autoupdate": false,
  "share": "disabled",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--isolated"]
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "ask",
    "doom_loop": "ask",
    "read": {
      "*": "allow",
      "*.env": "allow",
      "*.env.*": "allow",
      "*.env*": "allow",
      "~/.ssh/**": "deny"
    },
    "bash": {
      "*": "allow",
      "rm -rf*": "ask", "rm -fr*": "ask", "sudo *": "deny",
      "git push*": "ask", "git reset*": "ask", "git clean*": "ask", "git rebase*": "ask"
    },
    "playwright_browser_evaluate": "ask",
    "playwright_browser_run_code": "ask",
    "playwright_browser_file_upload": "ask"
  }
}
