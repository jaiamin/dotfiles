{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "edit": {
      "*": "ask",
      "*.env": "deny", "*.env.*": "deny", "*.env.example": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "ask",
    "doom_loop": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny", "*.env.*": "deny", "*.env.example": "allow",
      "~/.ssh/**": "deny", "~/.config/gh/**": "deny"
    },
    "bash": {
      "*": "ask",
      "sudo *": "deny",
      "git push --force*": "deny", "git push -f*": "deny",
      "rm *": "ask",
      "git reset --hard*": "ask", "git clean*": "ask", "git rebase*": "ask"
    }
  }
}
