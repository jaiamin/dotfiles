% sandbox, t3

# List sandboxes
sbx ls

# Create sandbox
bash "$(chezmoi source-path)/sandbox/manage.sh" create '<name>' '<repo>' '<base_agent>' '<browser>'

# Start sandbox
sbx run --detach --name '<sandbox>'

# Open sandbox shell
ssh '<sandbox>.sbx'

# Check sandbox
bash "$(chezmoi source-path)/sandbox/manage.sh" check '<sandbox>'

# Refresh sandbox agents and tools
bash "$(chezmoi source-path)/sandbox/manage.sh" refresh '<sandbox>'

# Stop sandbox
sbx stop '<sandbox>'

# List sandbox ports
bash "$(chezmoi source-path)/sandbox/manage.sh" ports '<sandbox>'

# Publish sandbox port to localhost
bash "$(chezmoi source-path)/sandbox/manage.sh" publish '<sandbox>' '<host_port>' '<sandbox_port>'

# Remove sandbox port mapping
bash "$(chezmoi source-path)/sandbox/manage.sh" unpublish '<sandbox>' '<host_port>' '<sandbox_port>'

# Allow one network host in sandbox
bash "$(chezmoi source-path)/sandbox/manage.sh" network-allow '<sandbox>' '<host>'

# Allow all outbound networks in sandbox
bash "$(chezmoi source-path)/sandbox/manage.sh" network-open '<sandbox>'

# Remove sandbox-wide network rule
bash "$(chezmoi source-path)/sandbox/manage.sh" network-restore '<sandbox>'

# Update shared sandbox skills
sbx skills update

# Delete sandbox and its files (confirms)
sbx rm '<sandbox>'

# Set sandbox provider API key
bash "$(chezmoi source-path)/sandbox/manage.sh" auth-set '<sandbox>' '<provider>'

# Remove sandbox provider API key
bash "$(chezmoi source-path)/sandbox/manage.sh" auth-remove '<sandbox>' '<provider>'

$ base_agent: printf '%s\n' codex claude cursor opencode --- --prevent-extra
$ browser: printf '%s\n' false true --- --prevent-extra
$ provider: printf '%s\n' openai anthropic --- --prevent-extra
$ repo: gh repo list jaiamin --limit 1000 --no-archived --json nameWithOwner --jq '.[].nameWithOwner'
$ sandbox: sbx ls -q --- --prevent-extra
