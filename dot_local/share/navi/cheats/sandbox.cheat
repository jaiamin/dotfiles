% sandbox, t3

# Create project sandbox for T3 Code (once per project)
bash "$(chezmoi source-path)/sandbox/manage.sh" create "<name>" "<repo>" "<agent>" "<browser>"

# Start or resume sandbox for T3 Code (keeps running until stopped)
sbx run --detach --name "<sandbox>"

# Stop sandbox, preserving files
sbx stop "<sandbox>"

# Inspect sandbox mounts and configuration
sbx inspect "<sandbox>"

# Test SSH connection or open sandbox shell
ssh "<sandbox>.sbx"

# Refresh sandbox tools and instructions (does not update agents)
bash "$(chezmoi source-path)/sandbox/manage.sh" refresh "<sandbox>" "<repo>" "<browser>"

# Update shared sandbox skills
sbx skills update

# Delete sandbox and its files (push work first; asks for confirmation)
sbx rm "<sandbox>"

# Set project API key
sbx secret set-custom --sandbox "<sandbox>" --host "<api_host>" --env "<key_name>"

# Remove project API key
sbx secret rm --sandbox "<sandbox>" --env-name "<key_name>"

# Create private GitHub repo with initial commit (no local checkout)
gh repo create "<new_repo>" --private --add-readme

$ api_host: printf '%s\n' api.openai.com api.anthropic.com
$ key_name: printf '%s\n' PROJECT_OPENAI_API_KEY PROJECT_ANTHROPIC_API_KEY
$ agent: printf '%s\n' claude codex opencode
$ browser: printf '%s\n' false true
$ repo: gh repo list jaiamin --limit 1000 --no-archived --json nameWithOwner --jq '.[].nameWithOwner'
$ sandbox: sbx ls -q

% github, project
