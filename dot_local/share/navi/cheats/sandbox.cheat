% sandbox, herdr

# Create a new task sandbox
repo="<repo>"; task="<task>"; agent="<agent>"; \
[[ "$task" =~ ^[a-z][a-z0-9-]{0,31}$ ]] && \
id="${task}-$(openssl rand -hex 4)" && \
HERDR_AGENT="$agent" sbx env run ~/.sbxenv.yaml \
  --name "${repo##*/}-${id}-${agent}" \
  --env-arg "repo=$repo" \
  --env-arg "agent=$agent" \
  --env-arg "task=$id" \
  --env-arg "branch=new" \
  --env-arg "browser=<browser>"

# Continue a pushed task branch with another agent
repo="<repo>"; branch="<branch>"; agent="<agent>"; \
[[ "$branch" =~ ^agent/[a-z][a-z0-9-]{0,31}-[0-9a-f]{8}$ ]] && \
id="$(openssl rand -hex 4)" && task_ref="${branch#agent/}" && \
HERDR_AGENT="$agent" sbx env run ~/.sbxenv.yaml \
  --name "${repo##*/}-${task_ref}-${id}-${agent}" \
  --env-arg "repo=$repo" \
  --env-arg "agent=$agent" \
  --env-arg "task=$task_ref" \
  --env-arg "branch=$branch" \
  --env-arg "browser=<browser>"

# Reopen sandbox
sandbox="<sandbox>"; HERDR_AGENT="${sandbox##*-}" sbx run --name "$sandbox"

# SSH into sandbox
ssh "<sandbox>.sbx"

# Open sandbox in VS Code
code --remote "ssh-remote+<sandbox>.sbx" /home/agent/workspace

# List sandboxes, status, and published ports
sbx ls

# Publish development port
sbx ports "<sandbox>" --publish <host_port>:<guest_port>

# Allow destination for one sandbox, e.g. example.com:443
sbx policy allow network --sandbox "<sandbox>" "<destination>"

# Allow all websites for one sandbox
sbx policy allow network --sandbox "<sandbox>" "**"

# Remove allow-all override for one sandbox
sbx policy rm network --sandbox "<sandbox>" --resource "**"

# Stop sandbox
sbx stop "<sandbox>"

# Show pending sandbox approvals
sbx policy approval ls

# Create new private GitHub project
gh repo create "jaiamin/<project>" --private --add-readme

$ agent: printf '%s\n' claude codex opencode
$ browser: printf '%s\n' false true
$ repo: gh repo list jaiamin --limit 1000 --no-archived --json nameWithOwner --jq '.[].nameWithOwner'
$ sandbox: sbx ls -q
$ branch: gh api "repos/<repo>/branches?per_page=100" --paginate --jq '.[].name' | grep -E '^agent/[a-z][a-z0-9-]{0,31}-[0-9a-f]{8}$'
