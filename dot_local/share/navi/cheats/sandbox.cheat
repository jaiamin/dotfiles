% sandbox, herdr

# Create a new task sandbox
repo="<repo>"; task="<task>"; agent="<agent>"; \
[[ "$task" =~ ^[a-z][a-z0-9-]{0,31}$ ]] || { echo 'Task: lowercase letters, digits, hyphens; max 32.' >&2; false; } && \
id="${task}-$(openssl rand -hex 4)" && \
HERDR_AGENT="$agent" sbx env run ~/.sbxenv.yaml \
  --name "${repo##*/}-${id}-${agent}" \
  --env-arg "repo=$repo" \
  --env-arg "agent=$agent" \
  --env-arg "task=$id" \
  --env-arg "branch=new" \
  --env-arg "browser=<browser>"

# Continue a pushed task branch with another agent
repo="<repo>"; branch="<branch>"; agent="<agent>"; \
[[ "$branch" =~ ^agent/[a-z][a-z0-9-]{0,31}-[0-9a-f]{8}$ ]] || { echo 'Not a task branch.' >&2; false; } && \
id="$(openssl rand -hex 4)" && task_ref="${branch#agent/}" && \
HERDR_AGENT="$agent" sbx env run ~/.sbxenv.yaml \
  --name "${repo##*/}-${task_ref}-${id}-${agent}" \
  --env-arg "repo=$repo" \
  --env-arg "agent=$agent" \
  --env-arg "task=$task_ref" \
  --env-arg "branch=$branch" \
  --env-arg "browser=<browser>"

# Reopen sandbox (also restarts the agent session after key changes)
sandbox="<sandbox>"; HERDR_AGENT="${sandbox##*-}" sbx run --name "$sandbox"

# SSH into sandbox
ssh "<sandbox>.sbx"

# Open sandbox in VS Code
code --remote "ssh-remote+<sandbox>.sbx" /home/agent/workspace

# List sandboxes, status, and published ports
sbx ls

# Publish development port
sbx ports "<sandbox>" --publish <host_port>:<guest_port>

# Unpublish development port
sbx ports "<sandbox>" --unpublish <host_port>:<guest_port>

# Show ports published by sandbox
sbx ports "<sandbox>"

# Allow destination for one sandbox, e.g. example.com:443
sbx policy allow network --sandbox "<sandbox>" "<destination>"

# Allow all websites for one sandbox
sbx policy allow network --sandbox "<sandbox>" "**"

# Remove allow-all override for one sandbox
sbx policy rm network --sandbox "<sandbox>" --resource "**"

# List network rules for one sandbox
sbx policy ls "<sandbox>"

# Show allowed and blocked hosts for one sandbox
sbx policy log "<sandbox>"

# Add API key to one sandbox (value hidden; allows HTTPS to its host)
sandbox="<sandbox>"; key="<key>"; host="<host>"; \
if [[ ! "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ || -z "$host" || "$host" == *[[:space:]/:]* ]]; then echo 'Invalid key or host.' >&2; \
else printf 'Value for %s: ' "$key"; IFS= read -rs value; echo; \
  if [[ -z ${value:-} ]]; then echo 'Empty value. Nothing set.' >&2; \
  else sbx secret set-custom --sandbox "$sandbox" \
      --env "$key" --host "$host" --value "$value" && \
    sbx policy allow network --sandbox "$sandbox" "$host:443"; fi; fi; \
unset value

# List API keys for one sandbox (names only, never values)
sbx secret ls --sandbox "<sandbox>"

# Remove API key from one sandbox (pick it, then remove its host rule)
sandbox="<sandbox>"; host="<host>"; \
sbx secret rm --sandbox "$sandbox" && \
sbx policy rm network --sandbox "$sandbox" --resource "$host:443"

# Stop sandbox
sbx stop "<sandbox>"

# Delete sandbox, its data, and its keys (will delete running sandboxes)
sbx rm --force "<sandbox>"

# Create new private GitHub project
gh repo create "jaiamin/<project>" --private --add-readme

$ agent: printf '%s\n' claude codex opencode
$ browser: printf '%s\n' false true
$ repo: gh repo list jaiamin --limit 1000 --no-archived --json nameWithOwner --jq '.[].nameWithOwner'
$ sandbox: sbx ls -q
$ branch: gh api "repos/<repo>/branches?per_page=100" --paginate --jq '.[].name' | grep -E '^agent/[a-z][a-z0-9-]{0,31}-[0-9a-f]{8}$'
