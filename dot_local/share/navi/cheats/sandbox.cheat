% sandbox, t3

# Create project sandbox for T3 Code (once per project)
bash "$(chezmoi source-path)/sandbox/manage.sh" create "<name>" "<repo>" "<agent>" "<browser>" --mobile "<mobile>"

# Start or resume sandbox for T3 Code (keeps running until stopped)
sbx run --detach --name "<sandbox>"

# Stop sandbox, preserving files
sbx stop "<sandbox>"

# Inspect sandbox mounts and configuration
sbx inspect "<sandbox>"

# Test SSH connection or open sandbox shell
ssh "<sandbox>.sbx"

# Enable mobile access at login and print address + fresh pairing code
sbx-mobile "<sandbox>"

# Check mobile connection
sbx-mobile status "<sandbox>"

# Disable mobile access and remove its bridge (keeps sandbox and code running)
sbx-mobile off "<sandbox>"

# Refresh sandbox tools and instructions (does not update agents)
bash "$(chezmoi source-path)/sandbox/manage.sh" refresh "<sandbox>" "<repo>" "<browser>"

# Update shared sandbox skills
sbx skills update

# Delete sandbox and its files (push work first; asks for confirmation)
sbx rm "<sandbox>"

# Set project API key
sandbox="<sandbox>"; key_name="<key_name>"; api_host="<api_host>"; \
placeholder="sbx-cs-$(openssl rand -hex 12)"; \
sbx policy allow network --sandbox "$sandbox" "$api_host:443" && \
sbx secret set-custom --sandbox "$sandbox" --host "$api_host" --env "$key_name" --placeholder "$placeholder" && \
sbx exec -u root "$sandbox" -- sh -c 'set -eu; f=/etc/sandbox-persistent.sh; touch "$f"; sed -i "/^export $1=/d" "$f"; printf "\nexport %s=%s\n" "$1" "$2" >> "$f"' _ "$key_name" "$placeholder"

# Remove project API key
sandbox="<sandbox>"; key_name="<key_name>"; \
sbx secret rm --sandbox "$sandbox" --host "<api_host>" --env-name "$key_name" && \
sbx exec -u root "$sandbox" -- sh -c 'sed -i "/^export $1=/d" /etc/sandbox-persistent.sh' _ "$key_name"

$ api_host: printf '%s\n' api.openai.com api.anthropic.com
$ key_name: printf '%s\n' OPENAI_API_KEY ANTHROPIC_API_KEY
$ agent: printf '%s\n' claude codex opencode
$ browser: printf '%s\n' false true
$ mobile: printf '%s\n' false true
$ repo: gh repo list jaiamin --limit 1000 --no-archived --json nameWithOwner --jq '.[].nameWithOwner'
$ sandbox: sbx ls -q

