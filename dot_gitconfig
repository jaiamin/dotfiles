	name = Jai Amin
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[credential "https://github.com"]
   	helper = !gh auth git-credential
[hook "gitleaks"]
	event = pre-commit
	command = gitleaks git --pre-commit --staged --redact --no-banner
